# MoleBridge commits to `staging`. `main` is production: it is the Cloudflare
# Pages production branch, so a commit landing there is a commit landing on the
# address a class opens. Promotion is a merge, said out loud.
work=staging
promote=main
escape=MOLEBRIDGE_PROMOTE

# Run on EVERY commit, including a promote, because it is about what is being
# committed rather than where. The release triplet — src/version.ts, the top of
# CHANGELOG.md, and the service worker's cache name — is three places holding
# one number, and the failure mode is a new release served out of a cache named
# for the old one, which is invisible until a reader is stuck on a stale build.
also=tools/version-check.mjs
#
# And the hub commit is written in two files here — the marker this repo has
# reconciled with, and the pin CI checks the hub out at to run the shared
# gates. They are the same fact and they drift silently, and when they do the
# shared gates go green while running rules this repo has already adopted and
# they have never heard of. It is repo-local ON PURPOSE, because a gate
# validating the pin cannot itself be fetched at that pin. (Hub LESSONS §117.)
also=tools/hub-pin-check.mjs
