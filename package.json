{
  "name": "molebridge",
  "version": "0.0.0",
  "private": true,
  "description": "Step-gated stoichiometry trainer \u2014 domain engine and completion-code codec.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "npm run generate && tsc -p tsconfig.build.json && node tools/assets.mjs",
    "clean": "rm -rf public/app",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "npm run generate && tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "tokens": "node tools/tokens-check.mjs",
    "version:check": "node tools/version-check.mjs",
    "cli": "node tools/cli.ts",
    "check": "npm run typecheck && npm run version:check && npm run tokens && npm run palette && npm test",
    "gates": "node ../noahjefferson/branch-guard.mjs --repo . && node ../noahjefferson/privacy-check.mjs --repo . && node ../noahjefferson/quote-check.mjs --repo . && node ../noahjefferson/docs-check.mjs . && node ../noahjefferson/pin-check.mjs --repo .",
    "doctrine": "node ../noahjefferson/doctrine-sync.mjs --repo .",
    "walk": "npm run build && node tools/walk.mjs",
    "a11y": "node tools/a11y.mjs",
    "og": "node tools/render-og.mjs",
    "palette": "node ../noahjefferson/palette-check.mjs palettes/molebridge.json",
    "branch": "node ../noahjefferson/branch-guard.mjs --repo .",
    "generate": "node tools/changelog.mjs",
    "prepare": "node ../noahjefferson/branch-guard.mjs --repo . --install >/dev/null 2>&1 || true"
  },
  "devDependencies": {
    "@types/node": "22.19.4",
    "playwright-core": "^1.62.1",
    "typescript": "7.0.2"
  }
}
